#!/usr/bin/env bash
#
# run_onchange_before_install-packages.sh
#
# Rebuild this machine's package set from the manifests captured in the
# dotfiles repo. Runs BEFORE chezmoi applies dotfiles, and re-runs
# whenever any manifest below changes — the fingerprints in this header
# make the rendered script differ, which is what chezmoi's run_onchange_
# attribute tracks.
#
# Every step is best-effort and idempotent: a package that was renamed or
# removed upstream is logged, not fatal, so a partial failure never blocks
# the rest of the apply. Re-run any time with:  chezmoi apply --force
#
# Manifest fingerprints (leave these — they are the change trigger):
#   Brewfile       {{ include "Brewfile"         | sha256sum }}
#   apt-packages   {{ include "apt-packages.txt" | sha256sum }}
#   uv-tools       {{ include "uv-tools.txt"     | sha256sum }}
#   npm-globals    {{ include "npm-globals.txt"  | sha256sum }}

set -uo pipefail

SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
FAILED=()

note() { printf '   %s\n' "$*"; }
warn() { FAILED+=("$*"); printf '   !! %s\n' "$*"; }

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=l

# --- apt --------------------------------------------------------------
# Bulk install first (fast); if that fails because one package vanished
# upstream, fall back to per-package so the rest still land.
if command -v apt-get >/dev/null 2>&1; then
    echo "==> apt packages"
    mapfile -t APT < <(grep -vE '^\s*(#|$)' "$SOURCE_DIR/apt-packages.txt")
    if [ "${#APT[@]}" -gt 0 ]; then
        sudo apt-get update -qq || warn "apt-get update failed"
        if ! sudo apt-get install -y --no-install-recommends "${APT[@]}" >/dev/null 2>&1; then
            note "bulk install failed; retrying individually to skip unavailable packages"
            for p in "${APT[@]}"; do
                sudo apt-get install -y --no-install-recommends "$p" >/dev/null 2>&1 \
                    || warn "apt: $p"
            done
        fi
    fi
fi

# --- Homebrew ---------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
    echo "==> installing Homebrew"
    # Homebrew's own prerequisites, in case the apt manifest didn't cover them.
    command -v apt-get >/dev/null 2>&1 \
        && sudo apt-get install -y --no-install-recommends curl git build-essential procps file >/dev/null 2>&1
    NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
        || warn "Homebrew install failed"
    for prefix in /home/linuxbrew/.linuxbrew /opt/homebrew /usr/local; do
        if [ -x "$prefix/bin/brew" ]; then
            eval "$("$prefix/bin/brew" shellenv)"
            break
        fi
    done
fi

if command -v brew >/dev/null 2>&1; then
    echo "==> brew bundle"
    brew bundle --file="$SOURCE_DIR/Brewfile" \
        || warn "some brew formulae/casks failed (see output above)"
fi

# --- uv tools ---------------------------------------------------------
# Each manifest line is the verbatim argument list for `uv tool install`
# (regenerated by uv-tools.gen.py from uv's own receipts): a plain name is
# PyPI, an absolute path is a local/editable source, plus any --with /
# --python flags. A local-source tool whose repo isn't checked out yet is
# skipped and logged rather than misresolved from PyPI.
if command -v uv >/dev/null 2>&1; then
    echo "==> uv tools"
    while IFS= read -r line; do
        line="${line%%#*}"                                # drop comments
        read -r -a args <<< "$line"                       # split on whitespace
        [ "${#args[@]}" -eq 0 ] && continue
        missing=""
        for a in "${args[@]}"; do
            case "$a" in /*) [ -e "$a" ] || missing="$a" ;; esac
        done
        if [ -n "$missing" ]; then
            warn "uv tool skipped (source not present: $missing): ${args[*]}"
            continue
        fi
        uv tool install --quiet "${args[@]}" >/dev/null 2>&1 || warn "uv tool: ${args[*]}"
    done < "$SOURCE_DIR/uv-tools.txt"
fi

# --- npm globals ------------------------------------------------------
# Manifest is `npm ls -g --depth=0`: drop the path header line, strip the
# tree glyphs and the trailing @version, keep scoped names intact. npm and
# corepack ship with node, so skip them.
if command -v npm >/dev/null 2>&1; then
    echo "==> npm globals"
    while read -r pkg; do
        [ -z "$pkg" ] && continue
        case "$pkg" in npm | corepack) continue ;; esac
        npm install -g "$pkg" >/dev/null 2>&1 || warn "npm -g: $pkg"
    done < <(tail -n +2 "$SOURCE_DIR/npm-globals.txt" | sed -E 's/^[^@A-Za-z]*//; s/@[^@]*$//')
fi

# --- summary ----------------------------------------------------------
echo
if [ "${#FAILED[@]}" -eq 0 ]; then
    echo "package install: all steps completed"
else
    echo "package install: ${#FAILED[@]} item(s) need attention:"
    for f in "${FAILED[@]}"; do printf '   - %s\n' "$f"; done
    echo "(fix, then re-run:  chezmoi apply --force)"
fi

# Never block the rest of the apply on a package that vanished upstream.
exit 0
